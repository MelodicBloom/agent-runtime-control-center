# Agent Runtime Control Center environment template
# Copy to .env.local for local development.
# Never commit .env.local.
# Replace every CHANGE_ME value with the actual value from that provider.

DATABASE_URL=CHANGE_ME_NEON_POSTGRES_URL
CONTROL_PLANE_API_KEY=CHANGE_ME_RANDOM_INTERNAL_SECRET
GATEWAY_API_KEY=CHANGE_ME_RANDOM_GATEWAY_SECRET

GATEWAY_CHATGPT_KEY=CHANGE_ME_RANDOM_CHATGPT_GATEWAY_SECRET
GATEWAY_PERPLEXITY_KEY=CHANGE_ME_RANDOM_PERPLEXITY_GATEWAY_SECRET
GATEWAY_TELEGRAM_KEY=CHANGE_ME_RANDOM_TELEGRAM_GATEWAY_SECRET
GATEWAY_DASHBOARD_KEY=CHANGE_ME_RANDOM_DASHBOARD_GATEWAY_SECRET

OPENAI_API_KEY=CHANGE_ME_OPENAI_KEY
PERPLEXITY_API_KEY=CHANGE_ME_PERPLEXITY_KEY

GITHUB_APP_ID=CHANGE_ME_GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY=CHANGE_ME_GITHUB_APP_PRIVATE_KEY
GITHUB_INSTALLATION_ID=CHANGE_ME_GITHUB_INSTALLATION_ID
GITHUB_WEBHOOK_SECRET=CHANGE_ME_GITHUB_WEBHOOK_SECRET

TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET
ADMIN_TELEGRAM_USER_ID=CHANGE_ME_ADMIN_TELEGRAM_USER_ID

VERCEL_TOKEN=CHANGE_ME_VERCEL_TOKEN
VERCEL_ORG_ID=CHANGE_ME_VERCEL_ORG_ID
VERCEL_PROJECT_ID=CHANGE_ME_VERCEL_PROJECT_ID
APP_BASE_URL=CHANGE_ME_DEPLOYED_APP_URL

DAYTONA_API_KEY=CHANGE_ME_DAYTONA_API_KEY
OPENHANDS_BASE_URL=CHANGE_ME_OPENHANDS_BASE_URL

DANGEROUS_OPERATION_CONFIRMATION=I_UNDERSTAND_THIS_CAN_CHANGE_OR_DELETE_DATA
